# -*- Mode: python; py-indent-offset: 4; indent-tabs-mode: nil; coding: utf-8; -*-

def build(bld):
    obj = bld.create_ns3_program('bgp-example', ['bgp', 'csma'])
    obj.source = 'bgp-example.cc'

    conv = bld.create_ns3_program('bgp-convergence-first', ['bgp', 'point-to-point', 'internet-apps', 'SCION'])
    conv.source = 'bgp-convergence-first.cc'

